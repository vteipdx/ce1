{
  "_comment": "copy to winnotify.json next to the exe. 0x-strings become ints. Every length below was read off the signed.sys dispatcher. 0x222000/0x222004 take the PID in +0x00 (NOT a CR3) and need +0x20 non-zero. Never set info_name_is_pointer=false: the driver dereferences +0x00.",
  "ioctl_info": "0x22200C",
  "ioctl_read": "0x222040",
  "ioctl_write": "0x222044",
  "ioctl_vread": "0x222000",
  "ioctl_vwrite": "0x222004",
  "ioctl_process": "0x222010",
  "ioctl_eprocess": "0x222014",
  "device_path": "\\\\.\\WinNotify",
  "service_name": "WinNotify",
  "driver_search": [
    "C:\\Windows\\System32\\drivers\\WinNotify.sys",
    "exe_dir\\WinNotify.sys",
    "exe_dir\\signeddrv.sys",
    "C:\\Windows\\System32\\drivers\\signeddrv.sys"
  ],
  "info_module_names": [
    "ntoskrnl.exe",
    "ntoskrnl"
  ],
  "info_name_is_pointer": true,
  "info_in_size": "0x18",
  "info_out_size": "0x20",
  "info_result_offset": "0x10",
  "read_in_size": "0x38",
  "read_out_size": "0x40",
  "read_bias": "0x10",
  "read_result_offset": "0x20",
  "read_qwords": 5,
  "write_in_size": "0x18",
  "write_out_size": 0,
  "vioctl_size": "0x28",
  "vioctl_layout": 0,
  "vioctl_pid_field": true,
  "vioctl_use_eprocess_cr3": true,
  "eprocess_pid": "0x440",
  "eprocess_pid_candidates": [
    "0x450",
    "0x438",
    "0x440"
  ],
  "eprocess_links": "0x448",
  "eprocess_dtb": "0x28",
  "eprocess_scan_bytes": "0x200",
  "eprocess_pool_scan": false,
  "eprocess_pool_start": "0xFFFF800000000000",
  "eprocess_pool_end": "0xFFFFC00000000000",
  "eprocess_pool_step": "0x1000",
  "eprocess_pool_max_pages": 4096,
  "ps_initial_system_offsets": [
    "0xCFC420",
    "0xD0A420",
    "0xD19420",
    "0xD8C420",
    "0xCFC3E0"
  ],
  "preferred_ps_offset": "0xCFC420",
  "probe_ps_offsets": false,
  "probe_eprocess_shifts": false,
  "eprocess_probe_shifts": [
    "0x10",
    0
  ],
  "cr3_mask": "0x000FFFFFFFFFF000",
  "phys_page_size": "0x1000",
  "vioctl_chunk": "0x1000",
  "max_process_iter": 2000,
  "keep_service": true,
  "force_unload": false,
  "vet_ioctl_packets": true,
  "allow_unknown_ioctl": true,
  "use_direct_vioctl": true,
  "autodetect": true,
  "kernel_base_via_system_info": true,
  "fallback_kernel_base": true,
  "ensure_debug_privilege": false
}
